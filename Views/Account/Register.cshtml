@{
    ViewData["Title"] = "Add user";
    var role = (string?)ViewBag.Role ?? "Staff";
}
<h1 class="h4 mb-3">Add user</h1>
<form asp-action="Register" method="post" class="panel" style="max-width:480px">
    <div class="mb-3">
        <label class="form-label">Username</label>
        <input name="username" value="@ViewBag.Username" class="form-control" required />
        <div class="form-text">3 to 50 characters. Letters, numbers, dot, dash, underscore. No spaces.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Full name</label>
        <input name="fullName" value="@ViewBag.FullName" class="form-control" required maxlength="100" />
    </div>
    <div class="mb-3">
        <label class="form-label">Outlet</label>
        <input name="outlet" value="@ViewBag.Outlet" class="form-control" maxlength="100" />
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <select name="role" class="form-select">
            <option value="Staff" selected="@(role == "Staff")">Staff</option>
            <option value="Supervisor" selected="@(role == "Supervisor")">Supervisor</option>
            <option value="Admin" selected="@(role == "Admin")">Admin</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Password (8 or more characters)</label>
        <input name="password" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
    </div>
    <button class="btn btn-zus">Create user</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-cream ms-1">Cancel</a>
</form>