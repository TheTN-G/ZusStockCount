@{
    ViewData["Title"] = "Create account";
    var role = (string?)ViewBag.Role ?? "Staff";
    bool supervisorOpen = ViewBag.SupervisorOpen == true;
}
<div class="panel login-card">
    <div class="login-logo" role="img" aria-label="Zus Coffee"></div>
    <h1 class="h4 text-center mb-3">Create account</h1>

    <form asp-action="Signup" method="post">
        <div class="mb-3">
            <label class="form-label">Store code</label>
            <input name="storeCode" class="form-control" autocomplete="off" required />
            <div class="form-text">Ask your admin for the store code.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input name="username" value="@ViewBag.Username" class="form-control" autocomplete="username" required />
            <div class="form-text">3 to 50 characters. Letters, numbers, dot, dash, underscore. No spaces.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Full name</label>
            <input name="fullName" value="@ViewBag.FullName" class="form-control" required maxlength="100" />
        </div>
        <div class="mb-3">
            <label class="form-label">Outlet</label>
            <input name="outlet" value="@ViewBag.Outlet" class="form-control" maxlength="100" />
        </div>
        <div class="mb-3">
            <label class="form-label">I am a</label>
            <select name="role" id="roleSelect" class="form-select">
                <option value="Staff" selected="@(role == "Staff")">Staff</option>
                @if (supervisorOpen)
                {
                    <option value="Supervisor" selected="@(role == "Supervisor")">Supervisor</option>
                }
            </select>
            @if (!supervisorOpen)
            {
                <div class="form-text">Supervisor accounts are created by an admin.</div>
            }
        </div>
        @if (supervisorOpen)
        {
            <div class="mb-3" id="supervisorKeyBox" style="display:none">
                <label class="form-label">Supervisor key</label>
                <input name="supervisorKey" id="supervisorKey" class="form-control" autocomplete="off" />
                <div class="form-text">The admin gives this key to supervisors only.</div>
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Password (8 or more characters)</label>
            <input name="password" type="password" class="form-control" autocomplete="new-password" required minlength="8" />
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm password</label>
            <input name="confirmPassword" type="password" class="form-control" autocomplete="new-password" required minlength="8" />
        </div>
        <button class="btn btn-zus w-100">Create account</button>
        <a asp-action="Login" class="btn btn-cream w-100 mt-2">Back to log in</a>
    </form>
</div>

@section Scripts {
    @if (supervisorOpen)
    {
        <script>
            (function () {
                var sel = document.getElementById('roleSelect');
                var box = document.getElementById('supervisorKeyBox');
                var key = document.getElementById('supervisorKey');
                function update() {
                    var isSup = sel.value === 'Supervisor';
                    box.style.display = isSup ? 'block' : 'none';
                    key.required = isSup;
                }
                sel.addEventListener('change', update);
                update();
            })();
        </script>
    }
}