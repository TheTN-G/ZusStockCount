@model StockCheckForm
@{
    ViewData["Title"] = "New stock check";
    var products = (List<Product>)ViewBag.Products;
    var scopeLabel = Model.Scope == "Category"
        ? $"{Model.ScopeName} category"
        : Model.Scope == "Item"
            ? products.FirstOrDefault()?.Name ?? "One item"
            : "All active stock";
}

<a asp-action="Index" class="btn-back"><span aria-hidden="true">&larr;</span> Back to stock checks</a>

<div class="my-3">
    <h1 class="h4 mb-1">Count @scopeLabel</h1>
    <p class="small mb-0">Enter the physical quantity in each product's loose unit. Leave no count blank.</p>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input asp-for="Scope" type="hidden" />
    <input asp-for="ScopeName" type="hidden" />

    <div class="panel mb-3">
        <label asp-for="Note" class="form-label fw-semibold">Count note (optional)</label>
        <input asp-for="Note" class="form-control" maxlength="500" placeholder="For example: evening close count" />
        <span asp-validation-for="Note" class="text-danger small"></span>
    </div>

    @if (!products.Any())
    {
        <div class="panel">No active products are available in this scope.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-zus align-middle">
                <thead>
                    <tr><th>Product</th><th>System quantity</th><th>Physical count</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < products.Count; i++)
                    {
                        var product = products[i];
                        <tr>
                            <td>
                                <input asp-for="Lines[i].ProductId" type="hidden" />
                                <a asp-controller="Stock" asp-action="Item" asp-route-id="@product.Id" class="fw-semibold">@product.Name</a>
                                <div class="small">@product.Category · @product.StorageZone · @product.BundleSizeText</div>
                            </td>
                            <td class="text-nowrap">@product.Pack(product.TotalLooseQty)</td>
                            <td style="min-width: 160px">
                                <label class="visually-hidden" asp-for="Lines[i].CountedQty">Physical count for @product.Name (@product.LooseUnit)</label>
                                <div class="input-group">
                                    <input asp-for="Lines[i].CountedQty" class="form-control" type="number" min="0" max="1000000" inputmode="numeric" required />
                                    <span class="input-group-text">@product.LooseUnit</span>
                                </div>
                                <span asp-validation-for="Lines[i].CountedQty" class="text-danger small"></span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
            <button class="btn btn-zus">Save count and adjust stock</button>
            <span class="small">Any variance updates stock and creates an activity record.</span>
        </div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

