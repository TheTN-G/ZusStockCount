@model StockCheck
@{
    ViewData["Title"] = "Stock check";
    var scopeLabel = Model.Scope == "Item"
        ? Model.Lines.FirstOrDefault()?.Product?.Name ?? "One item"
        : Model.Scope == "Category" ? Model.ScopeName ?? "Category" : "All active stock";
    var varianceCount = Model.Lines.Count(line => line.Difference != 0);
}

<a asp-action="Index" class="btn-back"><span aria-hidden="true">&larr;</span> Back to stock checks</a>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-start my-3">
    <div>
        <h1 class="h4 mb-1">Stock check · @scopeLabel</h1>
        <div class="small">@Model.CheckedAt.ToString("dd MMM yyyy, HH:mm") · Counted by @Model.CheckedBy</div>
        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="small mt-1">@Model.Note</div>
        }
    </div>
    <div class="d-flex gap-2">
        <span class="chip chip-grp">@Model.Lines.Count items</span>
        <span class="chip @(varianceCount == 0 ? "chip-status-approved" : "chip-status-pending")">@varianceCount variances</span>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-zus">
        <thead>
            <tr><th>Product</th><th class="text-end">Before</th><th class="text-end">Counted</th><th class="text-end">Variance</th><th>Adjustment</th></tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines.OrderBy(line => line.Product?.Category).ThenBy(line => line.Product?.Name))
            {
                var product = line.Product;
                var difference = line.Difference;
                var differenceText = product?.Pack(Math.Abs(difference)) ?? Math.Abs(difference).ToString();
                var sign = difference > 0 ? "+" : difference < 0 ? "−" : "";
                <tr class="@(difference < 0 ? "row-low" : "")">
                    <td>
                        @if (product != null)
                        {
                            <a asp-controller="Stock" asp-action="Item" asp-route-id="@product.Id" class="fw-semibold">@product.Name</a>
                            <div class="small">@product.Category</div>
                        }
                    </td>
                    <td class="text-end text-nowrap">@(product?.Pack(line.SystemQty) ?? line.SystemQty.ToString())</td>
                    <td class="text-end text-nowrap">@(product?.Pack(line.CountedQty) ?? line.CountedQty.ToString())</td>
                    <td class="text-end text-nowrap @(difference < 0 ? "text-danger" : difference > 0 ? "text-success" : "")">
                        @sign@differenceText
                    </td>
                    <td>@(difference == 0 ? "No change" : difference > 0 ? "Added to stock" : "Deducted from stock")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Create" asp-route-scope="@Model.Scope" asp-route-scopeName="@(Model.Scope == "Item" ? Model.Lines.FirstOrDefault()?.ProductId.ToString() : Model.ScopeName)" class="btn btn-zus mt-2">Start another count in this scope</a>

