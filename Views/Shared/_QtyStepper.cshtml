@model QtyField
<div class="qty-cell">
    <div class="qty-stepper qty-sm">
        <button type="button" class="qty-btn qty-minus" aria-label="Less">&minus;</button>
        <input type="number" class="form-control qty-input" name="@Model.Name" value="@Model.Value" min="0" max="1000000" step="1" />
        <button type="button" class="qty-btn qty-plus" aria-label="More">+</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.Unit))
    {
        <span class="small">@Model.Unit</span>
    }
</div>