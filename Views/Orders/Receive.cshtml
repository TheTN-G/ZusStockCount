@model StoreOrder
@{
    ViewData["Title"] = "Receive " + Model.OrderNumber;
    var pending = Model.OrderLines.Where(l => l.ReceiveStatus == ReceiveStatus.Pending)
        .OrderBy(l => l.Product!.Category).ThenBy(l => l.Product!.Name).ToList();
    var done = Model.OrderLines.Where(l => l.ReceiveStatus != ReceiveStatus.Pending).ToList();
    var products = (List<Product>)ViewBag.Products;
    var enteredLines = ViewBag.EnteredLines as Dictionary<int, ReceiveLineInput>;
    var enteredExtras = ViewBag.EnteredExtras as List<ExtraLineInput> ?? new List<ExtraLineInput>();
    bool enteredClose = ViewBag.EnteredClose == true;
    const int ExtraRows = 5;
}

<a asp-action="Details" asp-route-id="@Model.Id" class="btn-back"><span>&larr;</span> Back to order @Model.OrderNumber</a>

<h1 class="h4 my-3">Receive delivery: @Model.OrderNumber</h1>
<p class="small">For each item choose <strong>Received</strong> (adds to stock), <strong>Reject</strong> (write the reason) or <strong>Not yet</strong>. Quantity and expiry can be edited. If stock arrived that was not on the order, add it under Extra items.</p>

<form asp-action="Receive" asp-route-id="@Model.Id" method="post">

    @if (pending.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 m-0">Items on this order</h2>
            <button type="button" id="tickAll" class="btn btn-sm btn-outline-zus">Tick all as received</button>
        </div>
        <div class="table-responsive">
            <table class="table table-zus">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>What happened</th>
                        <th>Quantity that arrived</th>
                        <th>Expiry date</th>
                        <th>Reject reason</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < pending.Count; i++)
                    {
                        var l = pending[i];
                        var p = l.Product!;
                        ReceiveLineInput? e = null;
                        if (enteredLines != null) enteredLines.TryGetValue(l.Id, out e);
                        string action = e?.Action ?? "later";
                        int bundles = e?.Bundles ?? l.RequestedBundleQty;
                        int loose = e?.Loose ?? l.RequestedLooseQty;

                        <tr>
                            <td>
                                <strong>@p.Name</strong>
                                <div class="small">Ordered: @p.Pack(l.RequestedTotal)</div>
                            </td>
                            <td>
                                <input type="hidden" name="lines[@i].LineId" value="@l.Id" />
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check" name="lines[@i].Action" id="r@(i)a" value="received" checked="@(action == "received")" />
                                    <label class="btn btn-outline-success" for="r@(i)a">Received</label>
                                    <input type="radio" class="btn-check" name="lines[@i].Action" id="r@(i)b" value="reject" checked="@(action == "reject")" />
                                    <label class="btn btn-outline-danger" for="r@(i)b">Reject</label>
                                    <input type="radio" class="btn-check" name="lines[@i].Action" id="r@(i)c" value="later" checked="@(action == "later")" />
                                    <label class="btn btn-outline-secondary" for="r@(i)c">Not yet</label>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (l.UnitsPerBundle > 1)
                                    {
                                        @await Html.PartialAsync("_QtyStepper", new QtyField($"lines[{i}].Bundles", bundles, p.BundleUnit))
                                    }
                                    else
                                    {
                                        <input type="hidden" name="lines[@i].Bundles" value="0" />
                                    }
                                    @await Html.PartialAsync("_QtyStepper", new QtyField($"lines[{i}].Loose", loose, p.LooseUnit))
                                </div>
                            </td>
                            <td>
                                <input type="date" name="lines[@i].Expiry" value="@(e?.Expiry?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="min-width:150px" />
                            </td>
                            <td>
                                <input type="text" name="lines[@i].RejectNote" value="@e?.RejectNote" maxlength="300" class="form-control form-control-sm" placeholder="Needed if rejecting" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="panel mb-3">Every item on this order has been handled. You can still add extra items below.</div>
    }

    <h2 class="h6 mt-4">Extra items (arrived but not on the order)</h2>
    <p class="small">Leave unused rows empty.</p>
    <div class="table-responsive">
        <table class="table table-zus">
            <thead><tr><th>Item</th><th>Bundles</th><th>Loose</th><th>Expiry date</th></tr></thead>
            <tbody>
                @for (int x = 0; x < ExtraRows; x++)
                {
                    var ex = x < enteredExtras.Count ? enteredExtras[x] : null;
                    <tr>
                        <td>
                            <select name="extras[@x].ProductId" class="form-select form-select-sm" style="min-width:220px">
                                <option value="0">- choose item -</option>
                                @foreach (var grp in products.GroupBy(pp => pp.Category))
                                {
                                    <optgroup label="@grp.Key">
                                        @foreach (var item in grp)
                                        {
                                            <option value="@item.Id" selected="@(ex?.ProductId == item.Id)">@item.Name (@item.BundleSizeText)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </td>
                        <td>@await Html.PartialAsync("_QtyStepper", new QtyField($"extras[{x}].Bundles", ex?.Bundles ?? 0, null))</td>
                        <td>@await Html.PartialAsync("_QtyStepper", new QtyField($"extras[{x}].Loose", ex?.Loose ?? 0, null))</td>
                        <td><input type="date" name="extras[@x].Expiry" value="@(ex?.Expiry?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="min-width:150px" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (pending.Any())
    {
        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="closeOrder" name="closeOrder" value="true" checked="@enteredClose" />
            <label class="form-check-label" for="closeOrder">Close this order now. Items marked "Not yet" will be recorded as not delivered.</label>
        </div>
    }

    <div class="form-actions">
        <button class="btn btn-ok">Save delivery</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-cream">Cancel</a>
    </div>
</form>

@if (done.Any())
{
    <h2 class="h6 mt-4">Already handled</h2>
    <div class="table-responsive">
        <table class="table table-zus">
            <thead><tr><th>Item</th><th>Result</th><th>Quantity</th><th>Note</th></tr></thead>
            <tbody>
                @foreach (var l in done)
                {
                    <tr>
                        <td>@l.Product?.Name</td>
                        <td><span class="chip @ReceiveStatusUi.Css(l.ReceiveStatus)">@l.ReceiveStatus</span></td>
                        <td>@(l.ReceiveStatus == ReceiveStatus.Rejected ? "-" : l.Product?.Pack(l.ReceivedTotal))</td>
                        <td>@l.RejectNote</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        var tickAll = document.getElementById('tickAll');
        if (tickAll) {
            tickAll.addEventListener('click', function () {
                document.querySelectorAll('input[type=radio][value=received]').forEach(function (r) { r.checked = true; });
            });
        }
    </script>
}