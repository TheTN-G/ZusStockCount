@model List<StoreOrder>
@{
    ViewData["Title"] = "Orders";
    var show = (string?)ViewBag.Show ?? "";
    string Tab(string key) => show == key ? "btn-zus" : "btn-outline-zus";
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1 class="h4 m-0">Orders</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="NewDelivery" class="btn btn-cream">New product delivery</a>
        <a asp-action="Create" class="btn btn-zus">New order</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-4">
        <a asp-action="Index" asp-route-show="pending" class="stat-link">
            <div class="stat @((int)ViewBag.Pending > 0 ? "stat-soon" : "") @(show == "pending" ? "stat-on" : "")">
                <div class="stat-n">@ViewBag.Pending</div><div class="stat-l">Waiting for approval</div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a asp-action="Index" asp-route-show="approved" class="stat-link">
            <div class="stat @(show == "approved" ? "stat-on" : "")">
                <div class="stat-n">@ViewBag.Approved</div><div class="stat-l">Approved, not yet ordered</div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a asp-action="Index" asp-route-show="ontheway" class="stat-link">
            <div class="stat @(show == "ontheway" ? "stat-on" : "")">
                <div class="stat-n">@ViewBag.OnTheWay</div><div class="stat-l">On the way, to receive</div>
            </div>
        </a>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm @Tab("")">All</a>
    <a asp-action="Index" asp-route-show="pending" class="btn btn-sm @Tab("pending")">Pending</a>
    <a asp-action="Index" asp-route-show="approved" class="btn btn-sm @Tab("approved")">Approved</a>
    <a asp-action="Index" asp-route-show="ontheway" class="btn btn-sm @Tab("ontheway")">On the way</a>
    <a asp-action="Index" asp-route-show="received" class="btn btn-sm @Tab("received")">Received</a>
    <a asp-action="Index" asp-route-show="rejected" class="btn btn-sm @Tab("rejected")">Rejected</a>
</div>

<div class="table-responsive">
    <table class="table table-zus table-hover">
        <thead>
            <tr><th>Order no.</th><th>Date</th><th>Type</th><th>By</th><th class="text-end">Items</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@o.Id" class="fw-semibold">@o.OrderNumber</a></td>
                    <td>@o.OrderDate.ToString("dd MMM yyyy")</td>
                    <td>@(o.Source == "HQ Delivery" ? "Product delivery" : "Store order")</td>
                    <td>@o.CreatedBy</td>
                    <td class="text-end">@o.OrderLines.Count</td>
                    <td><span class="chip @OrderStatus.Css(o.Status)">@o.Status</span></td>
                    <td class="text-end">
                        @if (o.Status == OrderStatus.Ordered || o.Status == OrderStatus.PartlyReceived)
                        {
                            <a asp-action="Receive" asp-route-id="@o.Id" class="btn btn-sm btn-ok">Receive</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7">No orders here yet.</td></tr>
            }
        </tbody>
    </table>
</div>