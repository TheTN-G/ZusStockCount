@model Product
@{
    ViewData["Title"] = "Add product";
}

<a asp-action="Index">Back to all stock</a>
<h1 class="h4 my-2">Add product</h1>

<form asp-action="Create" method="post" class="panel" style="max-width:680px">
    <partial name="_ProductForm" model="Model" />
    <button class="btn btn-zus">Save product</button>
    <a asp-action="Index" class="btn btn-cream ms-1">Cancel</a>
</form>