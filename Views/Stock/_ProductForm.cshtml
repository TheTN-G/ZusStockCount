@model Product
@{
    bool isEdit = Model.Id > 0;
    int thresholdInput = (int?)ViewBag.ThresholdInput ?? Model.ThresholdLooseQty;
    string thresholdUnit = (string?)ViewBag.ThresholdUnit ?? "loose";
}

<div asp-validation-summary="All" class="text-danger small mb-2"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label">Product name</label>
    <input asp-for="Name" class="form-control" maxlength="120" required autofocus />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">Description (optional)</label>
    <textarea asp-for="Description" class="form-control" rows="2" maxlength="300"></textarea>
    <div class="form-text">For example the pack weight: 3300g. It is shown under the item name in the stock list.</div>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<ProductCategory>()" class="form-select"></select>
        <div class="form-text">Consumable = cups, lids, tissue, gloves. Cleaning = detergent, cleaners.</div>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="StorageZone" class="form-label"></label>
        <select asp-for="StorageZone" asp-items="Html.GetEnumSelectList<StorageType>()" class="form-select"></select>
        <div class="form-text">Ambient = room temperature, Chill = fridge, Frozen = freezer.</div>
    </div>
</div>

<div class="bundle-box mb-3">
    <div class="fw-semibold mb-2">Bundle size</div>
    <div class="row g-2">
        <div class="col-12 col-sm-4">
            <label asp-for="UnitsPerBundle" class="form-label small">Qty in one bundle</label>
            <input asp-for="UnitsPerBundle" type="number" min="1" max="1000000" class="form-control" required />
            <span asp-validation-for="UnitsPerBundle" class="text-danger small"></span>
        </div>
        <div class="col-12 col-sm-4">
            <label asp-for="LooseUnit" class="form-label small">Loose unit</label>
            <input asp-for="LooseUnit" class="form-control" maxlength="20" list="looseUnits" required />
            <datalist id="looseUnits">
                <option value="pkt"></option>
                <option value="btl"></option>
                <option value="pcs"></option>
                <option value="can"></option>
                <option value="tub"></option>
                <option value="roll"></option>
                <option value="box"></option>
            </datalist>
            <span asp-validation-for="LooseUnit" class="text-danger small"></span>
        </div>
        <div class="col-12 col-sm-4">
            <label asp-for="BundleUnit" class="form-label small">Bundle unit</label>
            <input asp-for="BundleUnit" class="form-control" maxlength="20" list="bundleUnits" required />
            <datalist id="bundleUnits">
                <option value="ctn"></option>
                <option value="box"></option>
                <option value="roll"></option>
                <option value="bdl"></option>
                <option value="pkt"></option>
            </datalist>
            <span asp-validation-for="BundleUnit" class="text-danger small"></span>
        </div>
    </div>
    <div class="mt-2">Bundle size: <strong id="bundlePreview"></strong></div>
    <div class="form-text">
        Example: <strong>12 btl / ctn</strong> means one carton holds 12 bottles.
        If the item has no carton or box (counted loose only, like a tub), enter <strong>1</strong>.
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Reorder threshold</label>
    <div class="input-group threshold-group">
        <input name="thresholdInput" id="thresholdInput" type="number" min="0" max="1000000" value="@thresholdInput" class="form-control" required />
        <select name="thresholdUnit" id="thresholdUnit" class="form-select">
            <option value="loose" selected="@(thresholdUnit != "bundle")" id="optLoose">@Model.LooseUnit</option>
            <option value="bundle" selected="@(thresholdUnit == "bundle")" id="optBundle">@Model.BundleUnit</option>
        </select>
    </div>
    <div class="form-text" id="thresholdHint"></div>
    <span asp-validation-for="ThresholdLooseQty" class="text-danger small"></span>
</div>

<div class="form-check mb-2">
    <input asp-for="TracksExpiry" class="form-check-input" />
    <label asp-for="TracksExpiry" class="form-check-label"></label>
    <div class="form-text">
        When ticked, stock has an expiry date. If none is entered when adding stock, it is set to
        @Product.DefaultExpiryMonths month from today (you can change it later).
    </div>
</div>

@if (isEdit)
{
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
        <div class="form-text">Untick if you stopped ordering this item. It will no longer show as low stock.</div>
    </div>
}

<script>
    (function () {
        var per = document.getElementById('UnitsPerBundle');
        var lu = document.getElementById('LooseUnit');
        var bu = document.getElementById('BundleUnit');
        var th = document.getElementById('thresholdInput');
        var unit = document.getElementById('thresholdUnit');
        var optLoose = document.getElementById('optLoose');
        var optBundle = document.getElementById('optBundle');
        var preview = document.getElementById('bundlePreview');
        var hint = document.getElementById('thresholdHint');

        function pack(total, p, looseName, bundleName) {
            if (p <= 1) return total + ' ' + looseName;
            var b = Math.floor(total / p), l = total % p, parts = [];
            if (b > 0) parts.push(b + ' ' + bundleName);
            if (l > 0) parts.push(l + ' ' + looseName);
            return (parts.length ? parts.join(' + ') : '0 ' + looseName) + ' (' + total + ' ' + looseName + ' in total)';
        }

        function update() {
            var p = Math.max(1, parseInt(per.value) || 1);
            var looseName = (lu.value || 'unit').trim();
            var bundleName = (bu.value || 'bundle').trim();
            var t = Math.max(0, parseInt(th.value) || 0);

            preview.textContent = p > 1
                ? p + ' ' + looseName + ' / ' + bundleName
                : 'Loose only (counted in ' + looseName + ')';

            optLoose.textContent = looseName;
            optBundle.textContent = bundleName;

            // A bundle option only makes sense when a bundle holds more than 1.
            optBundle.hidden = p <= 1;
            optBundle.disabled = p <= 1;
            if (p <= 1 && unit.value === 'bundle') unit.value = 'loose';

            var total = (unit.value === 'bundle' && p > 1) ? t * p : t;
            hint.textContent = 'Reorder when stock is at or below ' + pack(total, p, looseName, bundleName) + '.';
        }

        [per, lu, bu, th, unit].forEach(function (el) {
            el.addEventListener('input', update);
            el.addEventListener('change', update);
        });
        update();
    })();
</script>