@model Product
@{
    ViewData["Title"] = Model.Name;
    var today = DateTime.Today;
    var moves = (List<StockMove>)ViewBag.Moves;
    bool hasBundle = Model.UnitsPerBundle > 1;
}

<a asp-action="Index" class="btn-back"><span aria-hidden="true">&larr;</span> Back to stock</a>

<div class="d-flex justify-content-between align-items-start my-3 flex-wrap gap-2">
    <div>
        <h1 class="h4 mb-1">@Model.Name</h1>
        <span class="chip chip-@Model.StorageZone.ToString().ToLower()">@Model.StorageZone</span>
        <span class="chip chip-grp">@Model.Category</span>
        <span class="small ms-1">
            @(hasBundle ? $"Bundle size: {Model.BundleSizeText}" : $"Counted in {Model.LooseUnit}")
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="small mt-1">@Model.Description</div>
        }
        <div class="small mt-1">Last checked: @Model.LastCheckedText(today)</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Checks" asp-action="Create" asp-route-scope="Item" asp-route-scopeName="@Model.Id" class="btn btn-cream btn-sm">Count this item</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-zus btn-sm">Edit product and threshold</a>
    </div>
</div>

<div class="stat @(Model.IsLow ? "stat-low" : "") mb-3" style="max-width:440px">
    <div class="stat-n">@Model.Pack(Model.TotalLooseQty)</div>
    <div class="stat-l">
        @Model.TotalLooseQty @Model.LooseUnit in total. Reorder at @Model.Pack(Model.ThresholdLooseQty) or below.@(Model.IsLow ? " Stock is low." : "")
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <form asp-action="Add" method="post" class="panel panel-add">
            <h2 class="h6">Add stock</h2>
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="row g-3">
                @if (hasBundle)
                {
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Quantity (@Model.BundleUnit):</label>
                        <div class="qty-stepper">
                            <button type="button" class="qty-btn qty-minus" aria-label="Decrease">&minus;</button>
                            <input name="bundles" type="number" min="0" max="1000000" value="0" class="form-control qty-input" inputmode="numeric" />
                            <button type="button" class="qty-btn qty-plus" aria-label="Increase">+</button>
                        </div>
                    </div>
                }
                else
                {
                    <input type="hidden" name="bundles" value="0" />
                }
                <div class="col-12 col-sm-6">
                    <label class="form-label small fw-semibold">Quantity (@Model.LooseUnit@(hasBundle ? ", loose" : "")):</label>
                    <div class="qty-stepper">
                        <button type="button" class="qty-btn qty-minus" aria-label="Decrease">&minus;</button>
                        <input name="loose" type="number" min="0" max="1000000" value="0" class="form-control qty-input" inputmode="numeric" />
                        <button type="button" class="qty-btn qty-plus" aria-label="Increase">+</button>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Expiry date @(Model.TracksExpiry ? "" : "(optional)")</label>
                    <input name="expiry" type="date" class="form-control"
                           value="@(Model.TracksExpiry? today.AddMonths(Product.DefaultExpiryMonths).ToString("yyyy-MM-dd") : "")" />
                    @if (Model.TracksExpiry)
                    {
                        <div class="form-text">Pre-filled with @Product.DefaultExpiryMonths month from today. Change it if the pack shows another date. If left empty, the same default is used.</div>
                    }
                </div>
            </div>
            <button class="btn btn-ok mt-3">Add stock</button>
        </form>
    </div>
    <div class="col-md-6">
        <form asp-action="Use" method="post" class="panel panel-use">
            <h2 class="h6">Remove used stock</h2>
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="row g-3">
                @if (hasBundle)
                {
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Quantity (@Model.BundleUnit):</label>
                        <div class="qty-stepper">
                            <button type="button" class="qty-btn qty-minus" aria-label="Decrease">&minus;</button>
                            <input name="bundles" type="number" min="0" max="1000000" value="0" class="form-control qty-input" inputmode="numeric" />
                            <button type="button" class="qty-btn qty-plus" aria-label="Increase">+</button>
                        </div>
                    </div>
                }
                else
                {
                    <input type="hidden" name="bundles" value="0" />
                }
                <div class="col-12 col-sm-6">
                    <label class="form-label small fw-semibold">Quantity (@Model.LooseUnit@(hasBundle ? ", loose" : "")):</label>
                    <div class="qty-stepper">
                        <button type="button" class="qty-btn qty-minus" aria-label="Decrease">&minus;</button>
                        <input name="loose" type="number" min="0" max="1000000" value="0" class="form-control qty-input" inputmode="numeric" />
                        <button type="button" class="qty-btn qty-plus" aria-label="Increase">+</button>
                    </div>
                </div>
            </div>
            <p class="small mt-3 mb-0">Takes from the earliest expiry first and opens a bundle when needed.</p>
            <button class="btn btn-use mt-2">Remove stock</button>
        </form>
    </div>
</div>

<h2 class="h6">Stock by expiry date (earliest first)</h2>
<div class="table-responsive mb-4">
    <table class="table table-zus">
        <thead><tr><th>Expiry</th><th>Quantity</th><th>Received</th><th>Change expiry date</th></tr></thead>
        <tbody>
            @foreach (var b in Model.Batches.Where(b => b.Qty > 0).OrderBy(b => b.ExpiryDate ?? DateTime.MaxValue))
            {
                <tr>
                    <td class="text-nowrap @Product.ExpiryCss(b.ExpiryDate, today)">@(b.ExpiryDate?.ToString("dd MMM yyyy") ?? "No expiry")</td>
                    <td class="text-nowrap">@Model.Pack(b.Qty)</td>
                    <td class="text-nowrap">@b.ReceivedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <form asp-action="UpdateExpiry" method="post" class="expiry-form">
                            <input type="hidden" name="batchId" value="@b.Id" />
                            <input type="date" name="expiry" value="@(b.ExpiryDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                            <button class="btn btn-sm btn-outline-zus">Update</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Batches.Any(b => b.Qty > 0))
            {
                <tr><td colspan="4">No stock recorded yet. Use Add stock above.</td></tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h6">Recent activity</h2>
<div class="table-responsive">
    <table class="table table-zus">
        <thead><tr><th>When</th><th>Type</th><th>Change</th><th>By</th></tr></thead>
        <tbody>
            @foreach (var m in moves)
            {
                <tr>
                    <td class="text-nowrap">@m.At.ToString("dd MMM HH:mm")</td>
                    <td>
                        @m.Type
                        @if (!string.IsNullOrWhiteSpace(m.Note))
                        {
                            <div class="small item-desc">@m.Note</div>
                        }
                    </td>
                    <td class="text-nowrap @(m.Qty < 0 ? "text-danger" : "")">@(m.Qty > 0 ? "+" : "-")@Model.Pack(Math.Abs(m.Qty))</td>
                    <td>@m.UserName</td>
                </tr>
            }
            @if (!moves.Any())
            {
                <tr><td colspan="4">No activity yet.</td></tr>
            }
        </tbody>
    </table>
</div>